if(NOT DEFINED APP_BUNDLE)
  message(FATAL_ERROR "APP_BUNDLE must point to the macOS application bundle")
endif()

# Homebrew libraries are linked using absolute paths. Copy every non-system
# dependency into Contents/Frameworks and rewrite the Mach-O load commands so
# the application remains portable after it is moved to /Applications.
include(BundleUtilities)
set(BU_CHMOD_BUNDLE_ITEMS ON)
fixup_bundle("${APP_BUNDLE}" "" "")
